<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>O Guia Definitivo do Software: 57 Capítulos Interativos</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f0f4f8;
            color: #2d3748;
            line-height: 1.6;
        }

        .container {
            max-width: 860px;
            margin: 40px auto;
            padding: 40px;
            background-color: #ffffff;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border-radius: 16px;
        }

        header {
            text-align: center;
            margin-bottom: 35px;
            border-bottom: 2px dashed #e2e8f0;
            padding-bottom: 30px;
        }

        h1 {
            font-size: 2.6rem;
            color: #1a365d;
            margin: 0 0 10px 0;
            font-weight: 800;
        }

        .subtitle {
            font-size: 1.15rem;
            color: #718096;
            margin: 0;
        }

        .instructions {
            text-align: center;
            font-style: italic;
            color: #2b6cb0;
            background-color: #ebf8ff;
            padding: 14px;
            border-radius: 8px;
            margin-bottom: 30px;
            font-size: 0.95rem;
            border-left: 4px solid #3182ce;
        }

        details {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            margin-bottom: 12px;
            overflow: hidden;
            transition: all 0.2s ease;
        }

        details[open] {
            border-color: #3182ce;
            box-shadow: 0 4px 15px rgba(49, 130, 206, 0.1);
            background-color: #ffffff;
        }

        summary {
            padding: 18px 20px;
            font-size: 1.15rem;
            font-weight: 700;
            color: #2d3748;
            cursor: pointer;
            user-select: none;
            outline: none;
        }

        summary:hover {
            color: #2b6cb0;
            background-color: #ebf8ff;
        }

        details[open] summary {
            background-color: #ebf8ff;
            color: #2b6cb0;
            border-bottom: 1px solid #e2e8f0;
        }

        .content {
            padding: 25px;
            background-color: #ffffff;
            animation: fadeIn 0.3s ease-out;
        }

        p {
            margin: 0 0 16px 0;
            font-size: 1.05rem;
            color: #2d3748;
            text-align: justify;
        }

        p:last-child {
            margin-bottom: 0;
        }

        ul, ol {
            margin: 0 0 16px 0;
            padding-left: 25px;
        }

        li {
            font-size: 1.05rem;
            margin-bottom: 10px;
